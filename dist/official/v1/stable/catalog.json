    {
      "id": "AniList",
      "name": "AniList",
      "description": "Track manga progress and lists with AniList.",
      "version": "3.0.0",
      "icon": "icons/AniList.svg",
      "languages": [
        "multi"
      ],
      "contentRating": "SAFE",
      "capabilities": [
        "authentication",
        "progress",
        "trackerCollections",
        "trackerSearch"
      ],
      "developers": [
        {
          "name": "manko Extension Contributors",
          "github": "https://github.com/k800k/extensions"
        }
      ],
      "rightsDeclaration": "Licensed under Apache-2.0.",
      "rightsURL": "https://github.com/k800k/extensions/blob/main/extensions/tracker/AniList/LICENSE",
      "reportURL": "https://github.com/k800k/extensions/issues/new/choose",
      "sourceURL": "https://github.com/k800k/extensions/tree/main/extensions/tracker/AniList",
      "sourceRevision": "main",
      "entryType": "extension",
      "kind": "tracker",
      "availability": "available",
      "permissions": {
        "values": [
          "authenticationHandoff",
          "network",
          "trackerUpdates"
        ]
      },
      "extension": {
        "apiVersion": "3.0",
        "runtime": "wasm",
        "moduleURL": "sources/AniList/3.0.0/main.wasm",
        "sha256": "4b0971219543bc1f0cd57db2ae4bad40576c4276d4dc07678943b2e5840b7882",
        "size": 1251966,
        "allowedHTTPSHosts": [
          "anilist.co",
          "graphql.anilist.co",
          "s4.anilist.co"
        ],
        "authenticationModes": [
          "oauth2Implicit"
        ],
        "accountPolicy": {
          "authentication": {
            "mode": "oauth2Implicit",
            "authorizationURL": "https://anilist.co/api/v2/oauth/authorize",
            "callbackScheme": "manko",
            "callbackURL": "manko://oauth/anilist",
            "clientIDInfoPlistKey": "MANKO_ANILIST_OAUTH_CLIENT_ID",
            "responseType": "token",
            "scopes": []
          },
          "requests": [
            {
              "origin": "https://graphql.anilist.co",
              "pathPrefix": "/",
              "methods": [
                "POST"
              ],
              "operations": [
                "trackerSearch",
                "progress",
                "progressBatch",
                "collections"
              ],
              "bodyKind": "graphqlQuery"
            },
            {
              "origin": "https://graphql.anilist.co",
              "pathPrefix": "/",
              "methods": [
                "POST"
              ],
              "operations": [
                "update"
              ],
              "bodyKind": "graphqlMutation"
            }
          ]
        }
      },
      "moduleSHA256": "4b0971219543bc1f0cd57db2ae4bad40576c4276d4dc07678943b2e5840b7882",
      "license": "Apache-2.0",
      "compatibility": {
        "runtime": "native-wasm",
        "apiVersion": "3.0"
      },
      "upstream": {
        "repository": "https://github.com/inkdex/tracker-extensions",
        "branch": "0.9/stable",
        "commit": "d5002c2e144eeac8c69b236c7675c4ddedf2a0b8",
        "sourcePath": "src/AniList",
        "relationship": "behavioralReference"
      }
    },
