{
  "id": "MyAnimeList",
  "name": "MyAnimeList",
  "description": "Track manga progress and lists with MyAnimeList.",
  "kind": "tracker",
  "apiVersion": "3.0",
  "version": "3.0.0",
  "language": "multi",
  "languages": [
    "multi"
  ],
  "contentRating": "SAFE",
  "availability": "available",
  "capabilities": [
    "authentication",
    "progress",
    "trackerCollections",
    "trackerSearch"
  ],
  "permissions": [
    "authenticationHandoff",
    "network",
    "trackerUpdates"
  ],
  "allowedHTTPSHosts": [
    "api.myanimelist.net",
    "cdn.myanimelist.net",
    "myanimelist.net"
  ],
  "authenticationModes": [
    "oauth2PKCE"
  ],
  "developers": [
    {
      "name": "manko Extension Contributors",
      "github": "https://github.com/k800k/extensions"
    }
  ],
  "iconFile": "icon.svg",
  "license": "Apache-2.0",
  "runtime": "wasm",
  "crate": "manko-myanimelist",
  "compatibility": {
    "runtime": "native-wasm",
    "apiVersion": "3.0"
  },
  "accountPolicy": {
    "authentication": {
      "mode": "oauth2PKCE",
      "authorizationURL": "https://myanimelist.net/v1/oauth2/authorize",
      "callbackScheme": "manko",
      "callbackURL": "manko://oauth/myanimelist",
      "clientIDInfoPlistKey": "MANKO_MYANIMELIST_OAUTH_CLIENT_ID",
      "responseType": "code",
      "scopes": [],
      "tokenURL": "https://myanimelist.net/v1/oauth2/token",
      "pkceMethod": "plain"
    },
    "requests": [
      {
        "origin": "https://api.myanimelist.net",
        "pathPrefix": "/v2/",
        "methods": [
          "GET"
        ],
        "operations": [
          "trackerSearch",
          "progress",
          "progressBatch",
          "collections"
        ]
      },
      {
        "origin": "https://api.myanimelist.net",
        "pathPrefix": "/v2/",
        "methods": [
          "PUT"
        ],
        "operations": [
          "update"
        ]
      }
    ]
  }
}
